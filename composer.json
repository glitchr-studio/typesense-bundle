{
    "name": "glitchr/typesense-bundle",
    "description": "This bundle provides integration with Typesense in Symfony",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": "^8.0",
        "doctrine/doctrine-bundle": "^2.0|^3.0",
        "symfony/framework-bundle": "^3.4|^4.3|^5|^6.0|^7.0|^8.0",
        "symfony/http-client-contracts": "^1.0|^2.0|^3.0",
        "typesense/typesense-php": "^4.0|^5.0",
        "php-http/curl-client": "^2.2",

        "symfony/property-access": "^3.4|^4.3|^5|^6.0|^7.0|^8.0",
        "beberlei/doctrineextensions": "^1.0",
        "psr/simple-cache": "^1.0|^2.0|^3.0"
    },
    "require-dev": {
        "symfony/phpunit-bridge": "^5.0|^6.0|^7.0|^8.0",
        "phpunit/phpunit": "^9.5",
        "symfony/yaml": "^3.0|^4.0|^5.0|^6.0|^7.0|^8.0"
    },
    "autoload": {
        "psr-4": { "Typesense\\Bundle\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": {
            "Typesense\\Bundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-unit": "phpunit --testsuite unit",
        "test-integration": "phpunit --testsuite integration",
        "test-coverage": "XDEBUG_MODE=coverage phpunit --coverage-html var/coverage --coverage-text"
    }
}
