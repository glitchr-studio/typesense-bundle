{
    "name": "glitchr/typesense-bundle",
    "description": "Typesense for PHP the way Doctrine is for SQL: connections (DBAL), collections described by attributes or configuration, entities turned into documents and back, finders, queries and responses (ORM), and the indexing rule on Doctrine's events - framework-free; and its Symfony bundle.",
    "type": "symfony-bundle",
    "keywords": ["typesense", "search", "doctrine", "orm", "symfony", "bundle"],
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.1",
        "doctrine/collections": "^1.6|^2.0|^3.0",
        "doctrine/orm": "^2.10|^3.0",
        "doctrine/persistence": "^2.0|^3.0|^4.0",
        "php-http/curl-client": "^2.2",
        "psr/simple-cache": "^1.0|^2.0|^3.0",
        "symfony/cache": "^5.4|^6.0|^7.0|^8.0",
        "symfony/http-client-contracts": "^1.0|^2.0|^3.0",
        "symfony/property-access": "^5.4|^6.0|^7.0|^8.0",
        "typesense/typesense-php": "^4.0|^5.0"
    },
    "require-dev": {
        "doctrine/doctrine-bundle": "^2.0|^3.0",
        "phpunit/phpunit": "^9.5",
        "symfony/console": "^5.4|^6.0|^7.0|^8.0",
        "symfony/framework-bundle": "^5.4|^6.0|^7.0|^8.0",
        "symfony/phpunit-bridge": "^5.0|^6.0|^7.0|^8.0",
        "symfony/yaml": "^5.4|^6.0|^7.0|^8.0"
    },
    "suggest": {
        "symfony/framework-bundle": "In a Symfony application: Typesense\\Bundle\\TypesenseBundle, its configuration and services",
        "doctrine/doctrine-bundle": "In a Symfony application: the Doctrine indexer registered on the default entity manager",
        "symfony/console": "In a Symfony application: the typesense:* commands"
    },
    "autoload": {
        "psr-4": { "Typesense\\Bundle\\": "src/" },
        "files": ["src/aliases.php"]
    },
    "autoload-dev": {
        "psr-4": {
            "Typesense\\Bundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "test-unit": "phpunit --testsuite unit",
        "test-integration": "phpunit --testsuite integration",
        "test-coverage": "XDEBUG_MODE=coverage phpunit --coverage-html var/coverage --coverage-text"
    }
}
